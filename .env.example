# Required
FLASK_SECRET_KEY=generate-with-python-secrets-token-hex-32
FERNET_KEY=           # printed by setup_encrypt.py per document
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1        # set 0 for local aiosmtpd testing

# Optional features
DOCUMENT_NAME=Protected Document
WEBHOOK_URL=          # Slack/Discord incoming webhook URL
ADMIN_TOTP_SECRET=    # generated by setup_totp.py; enables 2FA when set
GEO_LOOKUP=0          # set 1 to enable geographic IP lookup via ip-api.com
FORCE_HTTPS=0         # set 1 in production behind SSL termination
SESSION_BIND_IP=0     # set 1 to bind sessions to the requestor's IP
CLEANUP_INTERVAL=3600 # seconds between cleanup runs

# Production
FLASK_DEBUG=0
